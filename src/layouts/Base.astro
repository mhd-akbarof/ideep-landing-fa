---
import '../styles/global.css';
import type { Copy } from '../data/fa';
interface Props { c: Copy }
const { c } = Astro.props;
const site = (Astro.site ?? new URL('https://ideep.ir')).origin;
const canonical = new URL(c.path, site).href;
const og = new URL('/og.jpg', site).href;
---
<!doctype html>
<html lang={c.lang} dir={c.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ideep" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={c.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#7047eb" />
  </head>
  <body><slot /></body>
</html>
